/* The time-lapse screen (#79, Keeper's Glass in #168, board 3.5). Look only: the logic is TimeLapseScreenModel, the code sets only
   data-driven values (band, pin and playhead x, the caption's lines). 1 pt = 2.75 px. Same limits as Glass.uss: one-sided
   margins, and no gap, :first-child, :last-child, :nth-child or :not. */

.tl-root { justify-content: flex-end; }

/* the timeline: a hit strip of --hit, a hairline band, era names as text under it, pin marks */
.tl-bar { height: var(--hit); margin-top: 54.5px; flex-shrink: 0; }
.tl-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tl-band { position: absolute; top: 49px; height: 22px; }
.tl-band--camp { background-color: var(--brass); }
.tl-band--village { background-color: var(--moss); }
.tl-band--town { background-color: var(--timber); }
.tl-band-label { position: absolute; left: 0; top: 25px; white-space: nowrap; }

/* Pin ticks stop short of the era names (question 20) */
.tl-pin { position: absolute; top: 36px; width: 5.5px; height: 38px; margin-left: -2.75px; background-color: var(--ink); }
.tl-pin--group { top: 29px; width: 8.25px; height: 45px; margin-left: -4.125px; }

.tl-playhead { position: absolute; top: 40.75px; width: 38.5px; height: 38.5px; margin-left: -19.25px; }
.tl-handle {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; rotate: 45deg;
    background-color: var(--primary); border-width: 5.5px; border-color: var(--on-primary);
}
.tl-year {
    position: absolute; top: -46px; margin: 0; padding: 5.5px 27.5px;
    border-radius: 30.25px; background-color: var(--ink);
    color: var(--on-primary); -unity-text-outline-width: 0.3px; -unity-text-outline-color: var(--on-primary);
    -unity-font-definition: var(--font-lora-bold); font-size: 38.5px; white-space: nowrap;
}

/* the rows under it */
.tl-row { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 16.5px; }
.tl-row > .kg-btn { margin-right: 19.25px; }
.tl-row > .kg-btn--compact { padding: 0 22px; }
.tl-row > .kg-btn--compact.kg-btn--off { padding-left: 93.5px; }
.tl-row > .tl-last { margin-right: 0; }
.tl-spacer { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.tl-icon { width: 126.5px; min-width: 126.5px; padding: 0; justify-content: center; align-items: center; }
.tl-book-ribbon { position: absolute; right: 24.75px; top: -2.75px; }
.tl-cap-row > .kg-dots { flex-shrink: 1; }

/* the caption: plain text in the panel, 27 % at most */
.tl-caption { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 16.5px; }
.tl-cap-portrait { margin-right: var(--space-10); }
.tl-caption-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.tl-caption .tl-caption-text {
    -unity-font-definition: var(--font-serif); font-size: 38.5px; -unity-text-align: upper-left;
    margin-right: 24.75px;
}

.tl-empty { flex-shrink: 0; margin-top: var(--space-4); }
.tl-empty > Label { white-space: normal; }

/* 375 x 667: one less line of story, and the strip sits closer to the panel's top */
.tl--short .tl-bar { margin-top: 44px; }
.tl--short .tl-row { margin-top: 11px; }
.tl--short .tl-caption { margin-top: 11px; }
