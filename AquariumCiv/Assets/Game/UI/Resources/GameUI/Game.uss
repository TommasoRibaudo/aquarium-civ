/* The game's screen UI, in the style kit's palette (View/Palette.cs, docs/design/spikes/style-kit.md).
   Panel units: 1080 wide (GameUiPanel). Tap targets >= 144 (48 dp / 44 pt). USS has no gap or nth-child:
   space children with one-sided margins (tooling.md §8). */

:root {
    /* ---------------- Keeper's Glass tokens (docs/design/ui/spec.md section 1). Sizes: 1 pt = 2.75 px of this 1080 wide panel ---------------- */
    --ink: #3D2A1E;
    --ink-soft: #4A3324;
    --timber: #6A4B36;
    --paper: #F3E9D6;
    --brass: #B88A3E;
    --edge: #D3B684;
    --brass-light: #D9B873;
    --primary: #9E5033;
    --primary-pressed: #7F3F28;
    --on-primary: #EFE3CC;
    --moss: #526E3A;
    --pressed-fill: #E2D3B3;
    /* Translucent tokens: the panel blends in linear light, so these are checked in a render, never copied from the boards' CSS. */
    --frost-tint: rgba(243, 233, 214, 0.72);
    --flat-tint: rgba(243, 233, 214, 0.92);
    --flat-sheet: rgba(243, 233, 214, 0.96); /* 94 on the spec; proposal question 31 asked for 96 */
    --quiet-backing: rgba(243, 233, 214, 0.72);
    --off-fill: rgba(243, 233, 214, 0.40);
    --dot-off: rgba(106, 75, 54, 0.52);
    --dark-plate: rgba(61, 42, 30, 0.96); /* the boards' 91 % in sRGB comes out at this in linear light */
    --shadow: rgba(46, 42, 39, 0.45);
    --clear: rgba(0, 0, 0, 0);

    --space-4: 11px;
    --space-6: 16.5px;
    --space-8: 22px;
    --space-10: 27.5px;
    --space-12: 33px;
    --space-16: 44px;
    --space-24: 66px;
    --hit: 144px; /* GameUiPanel.MinTarget: every tap target reaches this */
    --drawn: 121px; /* 44 pt: what small pieces show. Their reach is GlassReach */
    --hairline: 2.75px;

    --radius-chip: 38.5px;
    --radius-tile: 44px;
    --radius-toast: 49.5px;
    --radius-pin: 60.5px;
    --radius-button: 63.25px;
    --radius-peek: 66px;
    --radius-sheet: 71.5px;
    --radius-tool: 77px;

    --font-lora-bold: url("Fonts/Lora-Bold.asset");
    --font-lora-medium: url("Fonts/Lora-Medium.asset");
    --font-serif: url("Fonts/PT_Serif-Web-Regular.asset");
    --font-serif-bold: url("Fonts/PT_Serif-Web-Bold.asset");
    --font-serif-italic: url("Fonts/PT_Serif-Web-Italic.asset");

    --scrim: rgba(30, 26, 23, 0.45);
}

Label { white-space: normal; }

/* ---------------- HUD shell ---------------- */
.hud-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }



/* camera mode (#70): everything in the safe area hides except the way back */
.hud-photo > * { display: none; }
.hud-photo > .hud-photo-exit { display: flex; }
