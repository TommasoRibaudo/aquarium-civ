    <Compile Include="../../AquariumCiv/Assets/Game/Audio/Core/**/*.cs" />
    <!-- #76: Show me (target, echo plan), world bubbles in the people's voice, and their tests -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/ShowMe/Core/**/*.cs" />
    <!-- #75: the card stack on return (peek, paging, read state, Give) and its tests -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/Cards/Core/**/*.cs" />
    <!-- #85: the shaping looks (rain, grove, channel, herd over time), the answer shown, the take-back, and their tests -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/Shaping/Core/**/*.cs" />
    <!-- #79: the time-lapse screen model (timeline layout, pins, drag/snap, caption, Now, snapshot data) and its tests -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/TimeLapse/Core/**/*.cs" />
    <!-- #113/#146/#162/#175: the light, lamp, glass-night, camera-reach and near-glass-fade logic and its tests -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/Light/Core/**/*.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/LightTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/View/Grime/Core/**/*.cs" /><!-- #121 -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/Tests/GrimePatchTests.cs" />
    <Compile Include="Shims/*.cs" />
    <Compile Include="Readthrough/*.cs" /><!-- #61: [Explicit] transcript dump, run on demand -->
    <Compile Include="CameraGlassTests.cs" /><!-- #273: the glass limits of the camera -->
    <Compile Include="CrowdCardLifeTests.cs" /><!-- #148: the sim card from the real planner; here because Sim.Tests cannot see Life -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
