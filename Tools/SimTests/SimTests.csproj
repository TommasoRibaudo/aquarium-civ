<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the pure-C# slice sim tests outside Unity (docs/workflow.md, lane:sim), so sim work can be tested in
    parallel git worktrees without the Editor. Unity (and CI) stay the authority: this compiles the same files.
    Run: dotnet test Tools/SimTests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0414;NUnit2005;NUnit2006;NUnit2007;NUnit2015;NUnit2017</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../AquariumCiv/Assets/Game/Sim/**/*.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Life/**/*.cs" />
    <!-- #88: the moment director's pure core (beats as data, rail, hurry, waiting state) and its tests -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/Moments/Core/**/*.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/SimCoreTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/StoryAndNudgeTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/OfflineCatchUpTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EraTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/LifeStageTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/NotableCountTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/NameTests.cs" /><!-- #66 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/JobTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/JobFillTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/RoleTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/OfficeTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/SweeperTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/CardsTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/RelicTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/SettleTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/SettingTerrainTests.cs" /><!-- #115 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/ShapingTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/WishTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/DilemmaTests.cs" /><!-- P7 #220 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/ChoiceFixTests.cs" /><!-- visit loop C1 #368 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/DilemmaCallbackTests.cs" /><!-- P7 #221 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/DilemmaContentTests.cs" /><!-- P7 #222 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EcoTests.cs" /><!-- P8 #243: the ecology layer -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EcoWetTests.cs" /><!-- P8 polish 266 sim half, 271 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EcoSeenTests.cs" /><!-- P8 polish 281 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EcoRabbitTests.cs" /><!-- P8 polish 282 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EcoTweezersTests.cs" /><!-- 311, 314 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EcoMistHoldTests.cs" /><!-- P8 polish 266 view half: the hold -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EcoFirstRunTests.cs" /><!-- P8 #248 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/ReadthroughTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/EraMomentTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/ShelfTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/FirstRunTests.cs" /><!-- #94 -->
    <Compile Include="../../AquariumCiv/Assets/Game/Tests/RunAheadTests.cs" /><!-- #97 -->
