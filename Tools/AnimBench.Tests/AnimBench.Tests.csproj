<Project Sdk="Microsoft.NET.Sdk">
  <!--
    #352: tests for AnimBench (Tools/AnimBench): the harness itself (shims, clip format, the PeopleView-equivalent driver)
    and research 17 §4's principles over the committed clips. A clip's "knownGaps" are reported as Skipped ("KNOWN GAP"),
    so the suite is green and the gaps stay visible. Run: dotnet test Tools/AnimBench.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NUnit2005;NUnit2006;NUnit2007;NUnit2015;NUnit2017</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- #355: the beat kit's own pure tests run here too (the kit itself comes in through AnimBench.csproj) -->
    <Compile Include="../../AquariumCiv/Assets/Game/View/Tests/BeatKitTests.cs" />
    <Compile Include="../../AquariumCiv/Assets/Game/View/Tests/BerryMotionTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AnimBench/AnimBench.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
